{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist",
        "includeFiles": ["public/**"]
      }
    },
    {
      "src": "server/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/server/index.js" },

    {
      "src": "/admin/invoices-app/(.*)",
      "dest": "https://sparkling-stardust-b46625.netlify.app/$1"
    },

    { "src": "/(.*\\.(mp4|mov|webm|ogg))", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },

    { "src": "/admin/(.*)", "dest": "/index.html" },

    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}