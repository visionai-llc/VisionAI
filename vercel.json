{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist",
        "includeFiles": ["public/**"]
      }
    },
    {
      "src": "server/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/server/index.js" },

    {
      "src": "/admin/invoices-app/(.*)",
      "dest": "https://sparkling-stardust-b46625.netlify.app/$1"
    },

    { 
      "src": "/(.*\\.(js|css))", 
      "headers": { 
        "Cache-Control": "public, max-age=31536000, immutable",
        "X-Content-Type-Options": "nosniff"
      } 
    },
    { 
      "src": "/(.*\\.(jpg|jpeg|png|gif|webp|avif|svg))", 
      "headers": { 
        "Cache-Control": "public, max-age=31536000, immutable",
        "X-Content-Type-Options": "nosniff"
      } 
    },
    { 
      "src": "/(.*\\.(mp4|mov|webm|ogg))", 
      "headers": { 
        "Cache-Control": "public, max-age=31536000, immutable",
        "X-Content-Type-Options": "nosniff"
      } 
    },
    { 
      "src": "/index.html", 
      "headers": { 
        "Cache-Control": "public, max-age=0, must-revalidate",
        "X-Content-Type-Options": "nosniff"
      } 
    },

    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}